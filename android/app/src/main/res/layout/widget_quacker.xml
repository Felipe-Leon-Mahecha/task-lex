<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_quacker_background"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp">

            <ImageView
                android:id="@+id/widget_pet_image"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:contentDescription="Mascota activa de Quacker"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_count"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="top|end"
                android:background="@drawable/widget_quacker_count"
                android:gravity="center"
                android:maxLines="1"
                android:text="0"
                android:textColor="#201B12"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_pet_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tu mascota"
                android:textColor="#F7F7FA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_pending_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tu día, a la vista"
                android:textColor="#B6B8C4"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_next_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_quacker_task_background"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingTop="6dp"
        android:paddingEnd="11dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SIGUIENTE"
            android:textColor="#FFD166"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Todo listo"
            android:textColor="#F7F7FA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_when"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Toca para abrir tu día"
            android:textColor="#B6B8C4"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_empty_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_quacker_task_background"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:orientation="vertical"
        android:paddingStart="11dp"
        android:paddingTop="7dp"
        android:paddingEnd="11dp"
        android:paddingBottom="7dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡Todo listo!"
            android:textColor="#F7F7FA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Toca aquí para planear tu día"
            android:textColor="#B6B8C4"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_expanded_tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/widget_task_row_1"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:background="@drawable/widget_quacker_task_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="11dp">
            <TextView android:id="@+id/widget_task_title_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#F7F7FA" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_task_when_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:ellipsize="end" android:maxLines="1" android:textColor="#FFD166" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_task_row_2"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_quacker_task_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="11dp">
            <TextView android:id="@+id/widget_task_title_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#F7F7FA" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_task_when_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:ellipsize="end" android:maxLines="1" android:textColor="#FFD166" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_task_row_3"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/widget_quacker_task_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="11dp"
            android:paddingEnd="11dp">
            <TextView android:id="@+id/widget_task_title_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="#F7F7FA" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/widget_task_when_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:ellipsize="end" android:maxLines="1" android:textColor="#FFD166" android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
